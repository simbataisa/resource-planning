{
  "name": "@sit/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and client for the app database (design 5.2).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "check": "node scripts/check.mjs",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sit/engine": "workspace:*",
    "@sit/schemas": "workspace:*"
  },
  "devDependencies": {
    "@sit/config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "^17.2.0",
    "prisma": "^7.10.0",
    "tsx": "^4.20.0",
    "typescript": "catalog:"
  }
}
