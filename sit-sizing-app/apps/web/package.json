    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.10.0",
    "jsdom": "^30.0.0",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.1.0",
