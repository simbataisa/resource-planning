    "@sit/db": "workspace:*",
    "@sit/engine": "workspace:*",
    "@sit/schemas": "workspace:*",
    "@sit/tokens": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "animejs": "^4.2.0",
    "axios": "^1.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.0",
    "lucide-react": "^1.0.0",
    "next": "^16.3.0",
    "next-intl": "^4.4.0",
    "openid-client": "^6.8.0",
    "pino": "^10.0.0",
    "radix-ui": "^1.4.0",
