{
  "name": "@sit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json",
    "predev": "node scripts/vendor-scalar.mjs",
    "prebuild": "node scripts/vendor-scalar.mjs",
    "openapi:generate": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "openapi:lint": "redocly lint ../../docs/api/openapi.json --config ../../redocly.yaml",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:idp": "vitest run --config vitest.identity.config.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/sdk-node": "^0.300.0",
