# Names only. scripts/ensure-dev-env.mjs creates .env with random local values.
# Server environments take these from the platform secret store (design 11, Q4).

# --- Compose (local) ---
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
WEB_PORT=3000
DB_PORT=5432

# --- Keycloak (local compose) ---
KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN_PASSWORD=
KC_DEV_USER_PASSWORD=

# --- Web app (validated by apps/web/server/env.ts) ---
APP_ENV=local
APP_VERSION=
LOG_LEVEL=info
DATABASE_URL=
OTEL_SERVICE_NAME=sit-sizing-web
OTEL_EXPORTER_OTLP_ENDPOINT=
# oidc (default) | dev — dev also trusts the x-dev-user header / sit-dev-user cookie, local only
AUTH_MODE=
APP_BASE_URL=
OIDC_ISSUER=
OIDC_INTERNAL_URL=
OIDC_CLIENT_ID=sit-sizing-web
OIDC_CLIENT_SECRET=
# Audience a bearer access token must carry (MCP client, ADR-0016)
OIDC_API_AUDIENCE=sit-sizing-api
SESSION_SECRET=

# API requests per user per minute and instance (threat model T-11; tune with Q10)
RATE_LIMIT_PER_MINUTE=300

# --- MCP server (validated by apps/mcp/src/env.ts; ADR-0016) ---
# Also reads APP_ENV, LOG_LEVEL, OIDC_ISSUER, OIDC_INTERNAL_URL and OIDC_API_AUDIENCE above.
# Origin of the web app; the server calls <origin>/api/v1 with the caller's token.
SIT_API_BASE_URL=
# This server's public URL (OAuth protected resource; https outside local)
MCP_PUBLIC_URL=
MCP_PORT=3100
# Tool calls per user per minute and instance; keep below RATE_LIMIT_PER_MINUTE
MCP_RATE_LIMIT_PER_MINUTE=60
# Local only (APP_ENV=local): act as this seeded user via x-dev-user, without Keycloak
MCP_DEV_USER=

# --- Notifications (N-01; the worker service) ---
# SMTP server. Local compose: smtp://mail:1025 (Mailpit, UI on http://localhost:8025).
SMTP_URL=
MAIL_FROM=SIT Sizing <no-reply@sit-sizing.local>
NOTIFY_MAX_ATTEMPTS=6
NOTIFY_POLL_MS=5000
# web (default) | worker — set by the worker service
PROCESS_ROLE=

# Mailpit web UI port (local compose)
MAIL_UI_PORT=8025
